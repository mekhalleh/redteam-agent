# template.env — redteam-agent PROJECT environment (operational, non-admin)
# Copy to a local, git-ignored `.env` and fill the real values. Secrets live
# ONLY in `.env` / the Vaultwarden base / the platform secret store (AGENTS.md
# directive 6). Placeholders only here. Lines use `export` so `.env` can be sourced.

# htb-autopwn KB export source (the transferred intelligence) — identifier/URL
export HTB_KB_EXPORT_URL=

# Exegol MCP (loopback daemon) — the primary execution path (AGENTS.md directive 10 /
# the execution-environment skill). URL has a sane default; the Bearer TOKEN is a
# secret: its value lives ONLY here in the local .env / Vaultwarden, never in a
# tracked file. The repo .mcp.json reads both by ${env} expansion.
export EXEGOL_MCP_URL=http://127.0.0.1:2187/mcp
export EXEGOL_MCP_TOKEN=

# Privateer ingestion endpoint + token (feed the Stage-10 KB via its own path)
export PRIVATEER_INGEST_URL=
export PRIVATEER_INGEST_TOKEN=

# EXA-SI client Discord bot (external server, AGENTS.md directive 11) — least-privilege:
# reads the command channel (ONLY the authorized operator id), writes to the client
# notify channel, verifies the channel exists before posting. stdlib bot:
# discord/exasi_bot.py. The TOKEN is a secret: .env / Vaultwarden (e.g. redteam/exasi-bot-token),
# never a tracked file. The 3 ids are not secret (Discord "Copy ID", Developer Mode on).
export DISCORD_EXASI_BOT_TOKEN=
export EXASI_COMMANDS_CHANNEL_ID=
export EXASI_NOTIFY_CHANNEL_ID=
export EXASI_AUTHORIZED_USER_ID=
export EXASI_POLL_INTERVAL=10
