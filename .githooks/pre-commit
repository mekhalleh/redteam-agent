#!/usr/bin/env bash
# redteam-agent pre-commit (baseline B2/B3): judges the STAGED INDEX. Enable once
# per clone: git config core.hooksPath .githooks. Never --no-verify.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
fail=0
err() { echo "pre-commit: $*" >&2; fail=1; }
mapfile -t FILES < <(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n')
[ "${#FILES[@]}" -eq 0 ] && exit 0

# 1. Forbidden files.
for f in "${FILES[@]}"; do
  case "$f" in
    SECRETS.md|*.local.md|.claude/settings.local.json|.env|.env.*|*.pem|*.key|id_rsa*|id_ed25519*)
      [ "$f" = "template.env" ] || err "forbidden file staged: $f" ;;
  esac
done

# 2. Secrets: gitleaks on the staged changes when available, plus an offline
#    pattern check that always runs.
GL=$(command -v gitleaks || true)
[ -z "$GL" ] && [ -x "$HOME/Projects/www-pirates-re/_scripts/.bin/gitleaks" ] && GL="$HOME/Projects/www-pirates-re/_scripts/.bin/gitleaks"
if [ -n "$GL" ]; then
  "$GL" git --staged --no-banner --redact -c .gitleaks.toml >/dev/null 2>&1 \
    || "$GL" protect --staged --no-banner --redact -c .gitleaks.toml >/dev/null 2>&1 \
    || err "gitleaks found a secret in the staged changes"
fi
PATTERN='ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{80,}|cfat_[A-Za-z0-9]{40,}|-----BEGIN (RSA |OPENSSH |EC |)PRIVATE KEY-----|AKIA[0-9A-Z]{16}|sk-or-v1-[0-9a-f]{40,}|https://(canary\.|ptb\.)?discord(app)?\.com/api/webhooks/[0-9]{17,}/[A-Za-z0-9_-]{60,}'
hits=$(git diff --cached -U0 -- "${FILES[@]}" | grep -E '^\+' | grep -vE '^\+\+\+' | grep -nE "$PATTERN" || true)
[ -n "$hits" ] && err "secret-looking string in staged changes"

# 3. Syntax (conformant axis).
for f in "${FILES[@]}"; do
  [ -f "$f" ] || continue
  case "$f" in
    *.sh|.githooks/*) bash -n "$f" 2>/dev/null || err "bash syntax: $f" ;;
    *.py) python3 -m py_compile "$f" 2>/dev/null || err "python syntax: $f" ;;
    *.mjs|*.js) node --check "$f" 2>/dev/null || err "js syntax: $f" ;;
    *.rb) ruby -c "$f" >/dev/null 2>&1 || err "ruby syntax: $f" ;;
    *.json) python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$f" 2>/dev/null || err "json syntax: $f" ;;
    *.toml) python3 -c 'import tomllib,sys; tomllib.load(open(sys.argv[1],"rb"))' "$f" 2>/dev/null || err "toml syntax: $f" ;;
  esac
done

# 4. Shared content for Kimi: relative symlinks only (B7).
for shared in skills agents; do
  [ -L ".kimi-code/$shared" ] && [ "$(readlink ".kimi-code/$shared")" = "../.claude/$shared" ] \
    || err ".kimi-code/$shared must be a symlink to ../.claude/$shared"
done
for f in "${FILES[@]}"; do
  case "$f" in .kimi-code/skills|.kimi-code/agents) ;; .kimi-code/*) err "only the skills/agents symlinks belong in .kimi-code/: $f" ;; esac
done

# 5. Agent and skill frontmatter readable by both Claude Code and Kimi.
for f in "${FILES[@]}"; do
  case "$f" in
    .claude/agents/*.md|.claude/skills/*/SKILL.md)
      [ -f "$f" ] || continue
      python3 - "$f" <<'PY' || err "frontmatter invalid: $f"
import re, sys
path = sys.argv[1]
src = open(path).read()
m = re.match(r"\A---\n(.*?)\n---\n", src, re.S)
if not m or not src[m.end():].strip():
    sys.exit(1)
fm = dict(l.split(":", 1) for l in m.group(1).splitlines() if ":" in l and not l.startswith(" "))
fm = {k.strip(): v.strip().strip('"') for k, v in fm.items()}
name = fm.get("name", "")
if not fm.get("description"):
    sys.exit(1)
if path.startswith(".claude/agents/"):
    if name != path.rsplit("/", 1)[1][:-3]:
        sys.exit(1)
    reserved = {"claude", "claude-code-guide", "explore", "general-purpose", "plan", "statusline-setup", "coder", "translator"}
    if name.lower() in reserved:
        sys.exit(1)
    for k in ("tools", "disallowedTools"):
        if k in fm and not fm[k]:
            sys.exit(1)  # a YAML list: use a comma list
else:
    if name != path.split("/")[2]:
        sys.exit(1)
PY
      ;;
  esac
done

[ "$fail" -ne 0 ] && { echo "pre-commit: commit refused." >&2; exit 1; }
exit 0
